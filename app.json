{
  "expo": {
    "name": "Condoguard",
    "slug": "condoguard-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "condoguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "app.condoguard.morador" },
    "android": {
      "package": "app.condoguard.morador",
      "adaptiveIcon": { "foregroundImage": "./assets/images/adaptive-icon.png", "backgroundColor": "#ffffff" },
      "allowBackup": false
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-system-ui"],
    "experiments": { "typedRoutes": true },
    "extra": { "apiUrl": "http://10.0.2.2:8080" }
  }
}
